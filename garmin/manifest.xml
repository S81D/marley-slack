<?xml version="1.0"?>
<!-- fenix 7 Sapphire Solar is the standard fenix 7 as far as Connect IQ is
     concerned: Sapphire/Solar are hardware variants, not separate products. -->
<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
  <iq:application entry="MarleyApp"
                  id="ceb1b35a60fa47b69c35338e7a6f569c"
                  launcherIcon="@Drawables.LauncherIcon"
                  name="@Strings.AppName"
                  type="watch-app"
                  minApiLevel="4.0.0">
    <iq:products>
      <iq:product id="fenix7"/>
    </iq:products>
    <iq:permissions>
      <!-- Communications is required for makeWebRequest. -->
      <iq:uses-permission id="Communications"/>
    </iq:permissions>
    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
  </iq:application>
</iq:manifest>
